// v1.08 — tiny GGUF decode via session trit prepack cache
// Fixture: demos/weights/tiny_llm.gguf (vocab=8 dim=4 hidden=8, 1 layer)
// Prepack Q/K/V/O/FFN/lm_head once, then reuse weight_session_linear_trit_cached
// across tokens (build/hit + uncached parity + multi-step greedy decode).
// Note: no user-fn helper with params (Go emit binds only via local env) — use
// inline abs: (d < 0.0) | (0.0 - d) | d

fn main() {
    let vid = open_vocab("demos/weights/tiny_llm.vocab");
    let prompt = "AB";
    let ids = vocab_encode(vid, prompt);
    println(str_concat("prompt=", prompt));
    println(str_concat("prompt_ids=", to_str(ids)));

    let sid = open_weight_session("demos/weights/tiny_llm.gguf");
    let dim = 4;
    let vocab = 8;
    let hidden = 8;
    let E = weight_session_tensor(sid, "tok_emb");
    let g_attn = weight_session_window(sid, "attn_norm", 0, dim);
    let g_ffn = weight_session_window(sid, "ffn_norm", 0, dim);

    // ---- prepack linear layers (K = in-features) ----
    let b_q1 = weight_session_prepack_trit(sid, "attn_q", dim);
    let b_k1 = weight_session_prepack_trit(sid, "attn_k", dim);
    let b_v1 = weight_session_prepack_trit(sid, "attn_v", dim);
    let b_o1 = weight_session_prepack_trit(sid, "attn_o", dim);
    let b_u1 = weight_session_prepack_trit(sid, "ffn_up", dim);
    let b_d1 = weight_session_prepack_trit(sid, "ffn_down", hidden);
    let b_h1 = weight_session_prepack_trit(sid, "lm_head", dim);
    // second prepack → all hits
    let b_q2 = weight_session_prepack_trit(sid, "attn_q", dim);
    let b_u2 = weight_session_prepack_trit(sid, "ffn_up", dim);
    let b_h2 = weight_session_prepack_trit(sid, "lm_head", dim);
    println(str_concat("prepack_q_built=", to_str(b_q1)));
    println(str_concat("prepack_q_hit=", to_str(b_q2)));
    println(str_concat("prepack_up_built=", to_str(b_u1)));
    println(str_concat("prepack_up_hit=", to_str(b_u2)));
    println(str_concat("prepack_head_built=", to_str(b_h1)));
    println(str_concat("prepack_head_hit=", to_str(b_h2)));
    let packs = weight_session_has_trit_pack(sid, "attn_q")
        * weight_session_has_trit_pack(sid, "attn_k")
        * weight_session_has_trit_pack(sid, "attn_v")
        * weight_session_has_trit_pack(sid, "attn_o")
        * weight_session_has_trit_pack(sid, "ffn_up")
        * weight_session_has_trit_pack(sid, "ffn_down")
        * weight_session_has_trit_pack(sid, "lm_head");
    println(str_concat("all_packs_present=", to_str(packs)));

    // parity: uncached full-tile linear_trit vs cached (bitplane) on attn_q probe
    let xprobe = embed_row(E, ids[0], dim);
    let xpn = span_mul(rmsnorm(xprobe, 0.000001, 1.0), g_attn);
    let ru = weight_session_linear_trit(sid, "attn_q", xpn, dim, dim, dim, 0);
    let rc = weight_session_linear_trit_cached(sid, "attn_q", xpn, dim, dim, 1);
    let yu = ru[0];
    let yc = rc[0];
    let su = ru[1];
    let sc = rc[1];
    let d0r = yu[0] - yc[0];
    let d0 = (d0r < 0.0) | (0.0 - d0r) | d0r;
    let d1r = yu[3] - yc[3];
    let d1 = (d1r < 0.0) | (0.0 - d1r) | d1r;
    let dsr = su - sc;
    let ds = (dsr < 0.0) | (0.0 - dsr) | dsr;
    let parity_q = (d0 < 0.0001) * (d1 < 0.0001) * (ds < 0.0001);
    println(str_concat("parity_q_delta0=", to_str(d0)));
    println(str_concat("parity_q_ok=", to_str(parity_q)));

    // bitplane=1 for all decode linears (packed hit path)
    let bp = 1;

    // ---- pos 0 ----
    let t0 = ids[0];
    let x0 = embed_row(E, t0, dim);
    let x0n = span_mul(rmsnorm(x0, 0.000001, 1.0), g_attn);
    let q0 = weight_session_linear_trit_cached(sid, "attn_q", x0n, dim, dim, bp)[0];
    let k0 = weight_session_linear_trit_cached(sid, "attn_k", x0n, dim, dim, bp)[0];
    let v0 = weight_session_linear_trit_cached(sid, "attn_v", x0n, dim, dim, bp)[0];
    let q0r = rope(q0, 0.0);
    let k0r = rope(k0, 0.0);
    let Kc = kv_append(kv_new(), k0r);
    let Vc = kv_append(kv_new(), v0);
    let a0 = attn(q0r, Kc, Vc, dim);
    let a0o = weight_session_linear_trit_cached(sid, "attn_o", a0, dim, dim, bp)[0];
    let h0 = residual_add(x0, a0o);
    let h0n = span_mul(rmsnorm(h0, 0.000001, 1.0), g_ffn);
    let u0 = silu(weight_session_linear_trit_cached(sid, "ffn_up", h0n, hidden, dim, bp)[0]);
    let f0 = weight_session_linear_trit_cached(sid, "ffn_down", u0, dim, hidden, bp)[0];
    let y0 = residual_add(h0, f0);

    // ---- pos 1 ----
    let t1 = ids[1];
    let x1 = embed_row(E, t1, dim);
    let x1n = span_mul(rmsnorm(x1, 0.000001, 1.0), g_attn);
    let q1 = weight_session_linear_trit_cached(sid, "attn_q", x1n, dim, dim, bp)[0];
    let k1 = weight_session_linear_trit_cached(sid, "attn_k", x1n, dim, dim, bp)[0];
    let v1 = weight_session_linear_trit_cached(sid, "attn_v", x1n, dim, dim, bp)[0];
    let q1r = rope(q1, 1.0);
    let k1r = rope(k1, 1.0);
    let Kc = kv_append(Kc, k1r);
    let Vc = kv_append(Vc, v1);
    let a1 = attn(q1r, Kc, Vc, dim);
    let a1o = weight_session_linear_trit_cached(sid, "attn_o", a1, dim, dim, bp)[0];
    let h1 = residual_add(x1, a1o);
    let h1n = span_mul(rmsnorm(h1, 0.000001, 1.0), g_ffn);
    let u1 = silu(weight_session_linear_trit_cached(sid, "ffn_up", h1n, hidden, dim, bp)[0]);
    let f1 = weight_session_linear_trit_cached(sid, "ffn_down", u1, dim, hidden, bp)[0];
    let y1 = residual_add(h1, f1);
    let logits1 = weight_session_linear_trit_cached(sid, "lm_head", y1, vocab, dim, bp)[0];
    let gtok1 = sample_logits(logits1, 0.0);
    println(str_concat("gen1=", to_str(gtok1)));
    println(str_concat("gen1_tok=", vocab_token(vid, gtok1)));
    println(str_concat("kv_toks=", to_str(kv_len(Kc, dim))));

    // ---- gen pos 2 ----
    let x2 = embed_row(E, gtok1, dim);
    let x2n = span_mul(rmsnorm(x2, 0.000001, 1.0), g_attn);
    let q2 = weight_session_linear_trit_cached(sid, "attn_q", x2n, dim, dim, bp)[0];
    let k2 = weight_session_linear_trit_cached(sid, "attn_k", x2n, dim, dim, bp)[0];
    let v2 = weight_session_linear_trit_cached(sid, "attn_v", x2n, dim, dim, bp)[0];
    let q2r = rope(q2, 2.0);
    let k2r = rope(k2, 2.0);
    let Kc = kv_append(Kc, k2r);
    let Vc = kv_append(Vc, v2);
    let a2 = attn(q2r, Kc, Vc, dim);
    let a2o = weight_session_linear_trit_cached(sid, "attn_o", a2, dim, dim, bp)[0];
    let h2 = residual_add(x2, a2o);
    let h2n = span_mul(rmsnorm(h2, 0.000001, 1.0), g_ffn);
    let u2 = silu(weight_session_linear_trit_cached(sid, "ffn_up", h2n, hidden, dim, bp)[0]);
    let f2 = weight_session_linear_trit_cached(sid, "ffn_down", u2, dim, hidden, bp)[0];
    let y2 = residual_add(h2, f2);
    let logits2 = weight_session_linear_trit_cached(sid, "lm_head", y2, vocab, dim, bp)[0];
    let gtok2 = sample_logits(logits2, 0.0);
    println(str_concat("gen2=", to_str(gtok2)));
    println(str_concat("gen2_tok=", vocab_token(vid, gtok2)));

    // ---- gen pos 3 ----
    let x3 = embed_row(E, gtok2, dim);
    let x3n = span_mul(rmsnorm(x3, 0.000001, 1.0), g_attn);
    let q3 = weight_session_linear_trit_cached(sid, "attn_q", x3n, dim, dim, bp)[0];
    let k3 = weight_session_linear_trit_cached(sid, "attn_k", x3n, dim, dim, bp)[0];
    let v3 = weight_session_linear_trit_cached(sid, "attn_v", x3n, dim, dim, bp)[0];
    let q3r = rope(q3, 3.0);
    let k3r = rope(k3, 3.0);
    let Kc = kv_append(Kc, k3r);
    let Vc = kv_append(Vc, v3);
    let a3 = attn(q3r, Kc, Vc, dim);
    let a3o = weight_session_linear_trit_cached(sid, "attn_o", a3, dim, dim, bp)[0];
    let h3 = residual_add(x3, a3o);
    let h3n = span_mul(rmsnorm(h3, 0.000001, 1.0), g_ffn);
    let u3 = silu(weight_session_linear_trit_cached(sid, "ffn_up", h3n, hidden, dim, bp)[0]);
    let f3 = weight_session_linear_trit_cached(sid, "ffn_down", u3, dim, hidden, bp)[0];
    let y3 = residual_add(h3, f3);
    let logits3 = weight_session_linear_trit_cached(sid, "lm_head", y3, vocab, dim, bp)[0];
    let gtok3 = sample_logits(logits3, 0.0);
    println(str_concat("gen3=", to_str(gtok3)));
    println(str_concat("gen3_tok=", vocab_token(vid, gtok3)));
    println(str_concat("final_kv_toks=", to_str(kv_len(Kc, dim))));

    let out_ids = [gtok1, gtok2, gtok3];
    let out_txt = vocab_decode(vid, out_ids);
    println(str_concat("gen_text=", out_txt));

    // packs still present after multi-token reuse
    let packs_after = weight_session_has_trit_pack(sid, "attn_q")
        * weight_session_has_trit_pack(sid, "ffn_up")
        * weight_session_has_trit_pack(sid, "lm_head");
    // third prepack still a hit (no rebuild during decode)
    let b_q3 = weight_session_prepack_trit(sid, "attn_q", dim);
    println(str_concat("packs_after_decode=", to_str(packs_after)));
    println(str_concat("prepack_q_after_hit=", to_str(b_q3)));

    // multi-token reuse parity: cached scalar vs planes on last y
    // (bind nested indices — Go emit does not thread raw nested temps into fn args)
    let rc_s = weight_session_linear_trit_cached(sid, "lm_head", y3, vocab, dim, 0);
    let rc_p = weight_session_linear_trit_cached(sid, "lm_head", y3, vocab, dim, 1);
    let ys = rc_s[0];
    let yp = rc_p[0];
    let ss = rc_s[1];
    let sp = rc_p[1];
    let pd0r = ys[0] - yp[0];
    let pd0 = (pd0r < 0.0) | (0.0 - pd0r) | pd0r;
    let pd1r = ys[7] - yp[7];
    let pd1 = (pd1r < 0.0) | (0.0 - pd1r) | pd1r;
    let pdsr = ss - sp;
    let pds = (pdsr < 0.0) | (0.0 - pdsr) | pdsr;
    let parity_head = (pd0 < 0.0001) * (pd1 < 0.0001) * (pds < 0.0001);
    println(str_concat("parity_head_ok=", to_str(parity_head)));

    let hit_ok = (b_q1 == 1) * (b_q2 == 0) * (b_u1 == 1) * (b_u2 == 0)
        * (b_h1 == 1) * (b_h2 == 0) * (b_q3 == 0) * packs * packs_after;
    let decode_ok = (len(ids) == 2) * (kv_len(Kc, dim) == 4)
        * (gtok1 >= 0) * (gtok1 < vocab)
        * (gtok2 >= 0) * (gtok2 < vocab)
        * (gtok3 >= 0) * (gtok3 < vocab);
    let parity_ok = parity_q * parity_head;
    println(str_concat("cache_hit_ok=", to_str(hit_ok)));
    println(str_concat("parity_ok=", to_str(parity_ok)));
    println(str_concat("decode_ok=", to_str(decode_ok)));
    println(str_concat("tiny_gguf_decode_trit_ok=", to_str(hit_ok * parity_ok * decode_ok)));
    println("tiny_gguf_decode_trit_ok");

    close_weight_session(sid);
    close_vocab(vid);
}
