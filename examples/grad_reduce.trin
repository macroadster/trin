// reduce reverse-mode AD (v0.13)
// reduce((acc,x)=>acc + x*s, 0, [u,v,w]) = s*(u+v+w)

fn main() {
    let names = ["u", "v", "w", "s"];
    let vals = [1.0, 2.0, 3.0, 4.0];
    let g = grad_expr("reduce((acc,x)=>acc+x*s, 0, [u,v,w])", names, vals);
    println(str_concat("v = ", to_str(g[0])));
    println(str_concat("du = ", to_str(g[1])));
    println(str_concat("dv = ", to_str(g[2])));
    println(str_concat("dw = ", to_str(g[3])));
    println(str_concat("ds = ", to_str(g[4])));

    // fold alias + free init
    // fold((acc,x)=>acc*x + b, a, [c,d]) = ((a*c+b)*d + b)
    // a=2 c=3 d=4 b=1 → (2*3+1)*4 + 1 = 29
    // da = c*d = 12; dc = a*d = 8; dd = (a*c+b) = 7; db = d+1 = 5
    let names2 = ["a", "b", "c", "d"];
    let vals2 = [2.0, 1.0, 3.0, 4.0];
    let h = grad_expr("fold((acc,x)=>acc*x+b, a, [c,d])", names2, vals2);
    println(str_concat("q = ", to_str(h[0])));
    println(str_concat("da = ", to_str(h[1])));
    println(str_concat("db = ", to_str(h[2])));
    println(str_concat("dc = ", to_str(h[3])));
    println(str_concat("dd = ", to_str(h[4])));

    // reduce over map producer
    // reduce((acc,x)=>acc+x, 0, map((z)=>z*s, [p,q])) = s*(p+q)
    let names3 = ["p", "q", "s"];
    let vals3 = [2.0, 5.0, 3.0];
    let r = grad_expr("reduce((acc,x)=>acc+x, 0, map((z)=>z*s, [p,q]))", names3, vals3);
    println(str_concat("m = ", to_str(r[0])));
    println(str_concat("dp = ", to_str(r[1])));
    println(str_concat("dq = ", to_str(r[2])));
    println(str_concat("dms = ", to_str(r[3])));
}
