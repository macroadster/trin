// v1.13 — multi-layer GGUF greedy decode on trit-attn stack
// Fixture: demos/weights/tiny_llm2.gguf (vocab=8 dim=4 hidden=8, 2 layers)
// Prepack L0/L1 QKV/O/Up/Down + lm_head once; each token via
// weight_session_attn_stack_trit (layer-major KV flats grow); lm_head cached.
// Parity: stack ↔ two forward_attn_block_trit layers; multi-step KV grow.

fn main() {
    let vid = open_vocab("demos/weights/tiny_llm.vocab");
    let prompt = "AB";
    let ids = vocab_encode(vid, prompt);
    println(str_concat("prompt=", prompt));
    println(str_concat("prompt_ids=", to_str(ids)));

    let sid = open_weight_session("demos/weights/tiny_llm2.gguf");
    let dim = 4;
    let vocab = 8;
    let hidden = 8;
    let nLayers = 2;
    let bp = 1;
    let heads = 1;
    let ropeBase = 10000.0;
    let eps = 0.000001;
    let E = weight_session_tensor(sid, "tok_emb");
    let empty = [];

    // ---- prepack once ----
    // square / up: K = dim; down: K = hidden; head: K = dim
    let p1a = weight_session_prepack_trit_csv(sid,
        "L0_q,L0_k,L0_v,L0_o,L0_up,L1_q,L1_k,L1_v,L1_o,L1_up,lm_head", dim);
    let p1b = weight_session_prepack_trit_csv(sid, "L0_down,L1_down", hidden);
    let p2a = weight_session_prepack_trit_csv(sid,
        "L0_q,L0_k,L0_v,L0_o,L0_up,L1_q,L1_k,L1_v,L1_o,L1_up,lm_head", dim);
    let p2b = weight_session_prepack_trit_csv(sid, "L0_down,L1_down", hidden);
    println(str_concat("prepack_built=", to_str(p1a[0] + p1b[0])));
    println(str_concat("prepack_hits1=", to_str(p1a[1] + p1b[1])));
    println(str_concat("prepack_built2=", to_str(p2a[0] + p2b[0])));
    println(str_concat("prepack_hits2=", to_str(p2a[1] + p2b[1])));
    let packs = weight_session_has_trit_pack(sid, "L0_q")
        * weight_session_has_trit_pack(sid, "L0_down")
        * weight_session_has_trit_pack(sid, "L1_q")
        * weight_session_has_trit_pack(sid, "L1_down")
        * weight_session_has_trit_pack(sid, "lm_head");
    println(str_concat("all_packs_present=", to_str(packs)));

    let qCSV = "L0_q,L1_q";
    let kCSV = "L0_k,L1_k";
    let vCSV = "L0_v,L1_v";
    let oCSV = "L0_o,L1_o";
    let upCSV = "L0_up,L1_up";
    let downCSV = "L0_down,L1_down";
    let anCSV = "L0_an,L1_an";
    let fnCSV = "L0_fn,L1_fn";

    // ---- step 0: stack parity vs two blocks ----
    let t0 = ids[0];
    let x0 = embed_row(E, t0, dim);
    let st0 = weight_session_attn_stack_trit(
        sid, qCSV, kCSV, vCSV, oCSV, upCSV, downCSV,
        x0, empty, empty, dim, hidden, anCSV, fnCSV,
        heads, 0.0, ropeBase, bp, eps);
    let y0 = st0[0];
    let Kf = st0[1];
    let Vf = st0[2];
    // manual two blocks
    let b0 = weight_session_forward_attn_block_trit(
        sid, "L0_q", "L0_k", "L0_v", "L0_o", "L0_up", "L0_down",
        x0, empty, empty, dim, hidden, "L0_an", "L0_fn", heads, 0.0, ropeBase, bp, eps);
    let y0a = b0[0];
    let K0a = b0[1];
    let V0a = b0[2];
    let b1 = weight_session_forward_attn_block_trit(
        sid, "L1_q", "L1_k", "L1_v", "L1_o", "L1_up", "L1_down",
        y0a, empty, empty, dim, hidden, "L1_an", "L1_fn", heads, 0.0, ropeBase, bp, eps);
    let y0m = b1[0];
    let K1a = b1[1];
    let V1a = b1[2];
    let d0r = y0[0] - y0m[0];
    let d0 = (d0r < 0.0) | (0.0 - d0r) | d0r;
    let d1r = y0[3] - y0m[3];
    let d1 = (d1r < 0.0) | (0.0 - d1r) | d1r;
    let parity_stack0 = (d0 < 0.0001) * (d1 < 0.0001);
    // flat = L0|L1 each dim
    let flat0_ok = (len(Kf) == nLayers * dim) * (len(Vf) == nLayers * dim)
        * (len(K0a) == dim) * (len(K1a) == dim);
    println(str_concat("parity_stack0_ok=", to_str(parity_stack0)));
    println(str_concat("flat0_ok=", to_str(flat0_ok)));
    println(str_concat("kv0_flat_len=", to_str(len(Kf))));
    // keep K0a/V0a/K1a/V1a named so Go emit sees uses (flat concat check)
    let manual_flat_len = len(K0a) + len(K1a) + len(V0a) + len(V1a);
    println(str_concat("manual_kv_parts=", to_str(manual_flat_len)));

    // ---- continue prompt tok1 ----
    let t1 = ids[1];
    let x1 = embed_row(E, t1, dim);
    let st1 = weight_session_attn_stack_trit(
        sid, qCSV, kCSV, vCSV, oCSV, upCSV, downCSV,
        x1, Kf, Vf, dim, hidden, anCSV, fnCSV,
        heads, 1.0, ropeBase, bp, eps);
    let y1 = st1[0];
    let Kf = st1[1];
    let Vf = st1[2];
    println(str_concat("kv1_flat_len=", to_str(len(Kf))));
    // after 2 toks × 2 layers × dim = 16
    let grow1_ok = (len(Kf) == nLayers * 2 * dim);
    println(str_concat("grow1_ok=", to_str(grow1_ok)));

    // ---- gen token 1 ----
    let logits1 = weight_session_linear_trit_cached(sid, "lm_head", y1, vocab, dim, bp)[0];
    let gtok1 = sample_logits(logits1, 0.0);
    println(str_concat("gen1=", to_str(gtok1)));
    println(str_concat("gen1_tok=", vocab_token(vid, gtok1)));

    let x2 = embed_row(E, gtok1, dim);
    let st2 = weight_session_attn_stack_trit(
        sid, qCSV, kCSV, vCSV, oCSV, upCSV, downCSV,
        x2, Kf, Vf, dim, hidden, anCSV, fnCSV,
        heads, 2.0, ropeBase, bp, eps);
    let y2 = st2[0];
    let Kf = st2[1];
    let Vf = st2[2];
    let logits2 = weight_session_linear_trit_cached(sid, "lm_head", y2, vocab, dim, bp)[0];
    let gtok2 = sample_logits(logits2, 0.0);
    println(str_concat("gen2=", to_str(gtok2)));
    println(str_concat("gen2_tok=", vocab_token(vid, gtok2)));

    let x3 = embed_row(E, gtok2, dim);
    let st3 = weight_session_attn_stack_trit(
        sid, qCSV, kCSV, vCSV, oCSV, upCSV, downCSV,
        x3, Kf, Vf, dim, hidden, anCSV, fnCSV,
        heads, 3.0, ropeBase, bp, eps);
    let y3 = st3[0];
    let Kf = st3[1];
    let Vf = st3[2];
    let logits3 = weight_session_linear_trit_cached(sid, "lm_head", y3, vocab, dim, bp)[0];
    let gtok3 = sample_logits(logits3, 0.0);
    println(str_concat("gen3=", to_str(gtok3)));
    println(str_concat("gen3_tok=", vocab_token(vid, gtok3)));
    // 4 toks × 2 layers × dim = 32
    println(str_concat("final_kv_flat_len=", to_str(len(Kf))));
    let grow_final_ok = (len(Kf) == nLayers * 4 * dim) * (len(Vf) == nLayers * 4 * dim);
    println(str_concat("grow_final_ok=", to_str(grow_final_ok)));

    let out_ids = [gtok1, gtok2, gtok3];
    let out_txt = vocab_decode(vid, out_ids);
    println(str_concat("gen_text=", out_txt));

    // packs still present
    let packs_after = weight_session_has_trit_pack(sid, "L0_q")
        * weight_session_has_trit_pack(sid, "L1_down")
        * weight_session_has_trit_pack(sid, "lm_head");
    let pa = weight_session_prepack_trit_csv(sid, "L0_q,L1_q,lm_head", dim);
    let pb = weight_session_prepack_trit_csv(sid, "L0_down,L1_down", hidden);
    println(str_concat("packs_after_decode=", to_str(packs_after)));
    println(str_concat("prepack_after_hits=", to_str(pa[1] + pb[1])));

    // scalar vs bitplane head parity
    let rc_s = weight_session_linear_trit_cached(sid, "lm_head", y3, vocab, dim, 0);
    let rc_p = weight_session_linear_trit_cached(sid, "lm_head", y3, vocab, dim, 1);
    let ys = rc_s[0];
    let yp = rc_p[0];
    let pd0r = ys[0] - yp[0];
    let pd0 = (pd0r < 0.0) | (0.0 - pd0r) | pd0r;
    let pd1r = ys[7] - yp[7];
    let pd1 = (pd1r < 0.0) | (0.0 - pd1r) | pd1r;
    let parity_head = (pd0 < 0.0001) * (pd1 < 0.0001);
    println(str_concat("parity_head_ok=", to_str(parity_head)));

    // plane stack parity on first embed (no past)
    let sts = weight_session_attn_stack_trit(
        sid, qCSV, kCSV, vCSV, oCSV, upCSV, downCSV,
        x0, empty, empty, dim, hidden, anCSV, fnCSV,
        heads, 0.0, ropeBase, 0, eps);
    let yss = sts[0];
    let psr0 = y0[0] - yss[0];
    let ps0 = (psr0 < 0.0) | (0.0 - psr0) | psr0;
    let psr1 = y0[3] - yss[3];
    let ps1 = (psr1 < 0.0) | (0.0 - psr1) | psr1;
    let plane_ok = (ps0 < 0.0001) * (ps1 < 0.0001);
    println(str_concat("plane_ok=", to_str(plane_ok)));

    let hit_ok = (p1a[0] + p1b[0] == 13) * (p2a[0] + p2b[0] == 0)
        * (p2a[1] + p2b[1] == 13) * packs * packs_after
        * (pa[0] + pb[0] == 0);
    let decode_ok = (len(ids) == 2) * grow1_ok * grow_final_ok
        * (gtok1 >= 0) * (gtok1 < vocab)
        * (gtok2 >= 0) * (gtok2 < vocab)
        * (gtok3 >= 0) * (gtok3 < vocab)
        * flat0_ok;
    let parity_ok = parity_stack0 * parity_head * plane_ok;
    println(str_concat("cache_hit_ok=", to_str(hit_ok)));
    println(str_concat("parity_ok=", to_str(parity_ok)));
    println(str_concat("decode_ok=", to_str(decode_ok)));
    println(str_concat("tiny_gguf_decode_stack_trit_ok=", to_str(hit_ok * parity_ok * decode_ok)));
    println("tiny_gguf_decode_stack_trit_ok");

    close_weight_session(sid);
    close_vocab(vid);
}
