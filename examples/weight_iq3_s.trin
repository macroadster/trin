// v0.97 — IQ3_S GGUF dequant via weight sessions
fn main() {
    let id = open_weight_session("demos/weights/W_iq3_s.gguf");
    let w = weight_session_tensor(id, "W");
    println(str_concat("n=", to_str(len(w))));
    println(str_concat("w0=", to_str(w[0])));
    let y = weight_session_linear(id, "W", w, 1, 256, 8);
    println(str_concat("y=", to_str(y)));
    let ok = (y[0] > 200.0) * (y[0] < 300.0) * (w[0] > 0.5) * (w[0] < 1.5);
    println(str_concat("iq3_s_ok=", to_str(ok)));
    close_weight_session(id);
    println("weight_iq3_s_ok");
}
