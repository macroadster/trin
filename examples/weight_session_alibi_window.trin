// v1.18 — sliding-window ALiBi GQA SwiGLU
// Fixture: demos/weights/tiny_tied_alibi.gguf
// window=0 matches full ALiBi; window=2 local attention still generates stably.

fn main() {
    let vid = open_vocab("demos/weights/tiny_llm.vocab");
    let prompt = "AB";
    let ids = vocab_encode(vid, prompt);
    println(str_concat("prompt=", prompt));
    println(str_concat("prompt_ids=", to_str(ids)));

    let sid = open_weight_session("demos/weights/tiny_tied_alibi.gguf");
    let dim = 4;
    let vocab = 8;
    let hidden = 8;
    let nLayers = 2;
    let nHeads = 2;
    let nKV = 1;
    let dKV = 2;
    let bp = 1;
    let eps = 0.000001;
    let empty = [];
    let win = 2;

    let p1a = weight_session_prepack_trit_csv(sid,
        "L0_q,L0_k,L0_v,L0_o,L0_gate,L0_up,L1_q,L1_k,L1_v,L1_o,L1_gate,L1_up,tok_emb", dim);
    let p1b = weight_session_prepack_trit_csv(sid, "L0_down,L1_down", hidden);
    let p2a = weight_session_prepack_trit_csv(sid,
        "L0_q,L0_k,L0_v,L0_o,L0_gate,L0_up,L1_q,L1_k,L1_v,L1_o,L1_gate,L1_up,tok_emb", dim);
    let p2b = weight_session_prepack_trit_csv(sid, "L0_down,L1_down", hidden);
    println(str_concat("prepack_built=", to_str(p1a[0] + p1b[0])));
    println(str_concat("prepack_hits2=", to_str(p2a[1] + p2b[1])));

    let qCSV = "L0_q,L1_q";
    let kCSV = "L0_k,L1_k";
    let vCSV = "L0_v,L1_v";
    let oCSV = "L0_o,L1_o";
    let gateCSV = "L0_gate,L1_gate";
    let upCSV = "L0_up,L1_up";
    let downCSV = "L0_down,L1_down";
    let anCSV = "L0_an,L1_an";
    let fnCSV = "L0_fn,L1_fn";

    let t0 = ids[0];
    let t1 = ids[1];
    let x0 = weight_session_embed_row(sid, "tok_emb", t0, dim);
    let x1 = weight_session_embed_row(sid, "tok_emb", t1, dim);
    let xs = [x0[0], x0[1], x0[2], x0[3], x1[0], x1[1], x1[2], x1[3]];

    // full vs window=0 prefill parity
    let pf = weight_session_gqa_swiglu_prefill_alibi(
        sid, qCSV, kCSV, vCSV, oCSV, gateCSV, upCSV, downCSV,
        xs, empty, empty, dim, hidden, nHeads, nKV, 2,
        anCSV, fnCSV, 0.0, bp, eps);
    let pf0 = weight_session_gqa_swiglu_prefill_alibi_window(
        sid, qCSV, kCSV, vCSV, oCSV, gateCSV, upCSV, downCSV,
        xs, empty, empty, dim, hidden, nHeads, nKV, 2,
        anCSV, fnCSV, 0.0, bp, eps, 0);
    let d0r = pf[0][0] - pf0[0][0];
    let d0 = (d0r < 0.0) | (0.0 - d0r) | d0r;
    let d1r = pf[3][0] - pf0[3][0];
    let d1 = (d1r < 0.0) | (0.0 - d1r) | d1r;
    let parity0_ok = (d0 < 0.0001) * (d1 < 0.0001) * (len(pf[1]) == len(pf0[1]));
    println(str_concat("parity0_ok=", to_str(parity0_ok)));

    // window=2 prefill + sequential stack
    let pfw = weight_session_gqa_swiglu_prefill_alibi_window(
        sid, qCSV, kCSV, vCSV, oCSV, gateCSV, upCSV, downCSV,
        xs, empty, empty, dim, hidden, nHeads, nKV, 2,
        anCSV, fnCSV, 0.0, bp, eps, win);
    let Yf = pfw[0];
    let Kp = pfw[1];
    let Vp = pfw[2];
    let yLast = pfw[3];
    println(str_concat("Yflat_len=", to_str(len(Yf))));
    println(str_concat("prefill_kv_len=", to_str(len(Kp))));

    let s0 = weight_session_gqa_swiglu_stack_alibi_window(
        sid, qCSV, kCSV, vCSV, oCSV, gateCSV, upCSV, downCSV,
        x0, empty, empty, dim, hidden, nHeads, nKV, 2,
        anCSV, fnCSV, 0.0, bp, eps, win);
    let s1 = weight_session_gqa_swiglu_stack_alibi_window(
        sid, qCSV, kCSV, vCSV, oCSV, gateCSV, upCSV, downCSV,
        x1, s0[1], s0[2], dim, hidden, nHeads, nKV, 2,
        anCSV, fnCSV, 1.0, bp, eps, win);
    let pr = Yf[0] - s0[0][0];
    let pd = (pr < 0.0) | (0.0 - pr) | pr;
    let pr2 = yLast[0] - s1[0][0];
    let pd2 = (pr2 < 0.0) | (0.0 - pr2) | pr2;
    let parity_ok = (pd < 0.0001) * (pd2 < 0.0001);
    println(str_concat("parity_ok=", to_str(parity_ok)));

    let yBn = weight_session_final_norm(sid, yLast, dim, "final_norm", eps);
    let gtok1 = sample_logits(weight_session_logits_tied(sid, "tok_emb", yBn, dim), 0.0);
    println(str_concat("gen1=", to_str(gtok1)));
    println(str_concat("gen1_tok=", vocab_token(vid, gtok1)));

    let x2 = weight_session_embed_row(sid, "tok_emb", gtok1, dim);
    let st2 = weight_session_gqa_swiglu_stack_alibi_window(
        sid, qCSV, kCSV, vCSV, oCSV, gateCSV, upCSV, downCSV,
        x2, Kp, Vp, dim, hidden, nHeads, nKV, 2,
        anCSV, fnCSV, 2.0, bp, eps, win);
    let y2n = weight_session_final_norm(sid, st2[0], dim, "final_norm", eps);
    let gtok2 = sample_logits(weight_session_logits_tied(sid, "tok_emb", y2n, dim), 0.0);
    println(str_concat("gen2=", to_str(gtok2)));
    println(str_concat("gen2_tok=", vocab_token(vid, gtok2)));

    let x3 = weight_session_embed_row(sid, "tok_emb", gtok2, dim);
    let st3 = weight_session_gqa_swiglu_stack_alibi_window(
        sid, qCSV, kCSV, vCSV, oCSV, gateCSV, upCSV, downCSV,
        x3, st2[1], st2[2], dim, hidden, nHeads, nKV, 2,
        anCSV, fnCSV, 3.0, bp, eps, win);
    let y3n = weight_session_final_norm(sid, st3[0], dim, "final_norm", eps);
    let gtok3 = sample_logits(weight_session_logits_tied(sid, "tok_emb", y3n, dim), 0.0);
    println(str_concat("gen3=", to_str(gtok3)));
    println(str_concat("gen3_tok=", vocab_token(vid, gtok3)));
    println(str_concat("final_kv_flat_len=", to_str(len(st3[1]))));
    let grow_ok = (len(st3[1]) == nLayers * 4 * dKV) * (len(st3[2]) == nLayers * 4 * dKV);
    println(str_concat("grow_final_ok=", to_str(grow_ok)));
    // with window=2 after 4 tokens cache still holds full history (mask-only)
    let window_mask_only = (len(st3[1]) == nLayers * 4 * dKV);
    println(str_concat("window_mask_only=", to_str(window_mask_only)));

    let out_ids = [gtok1, gtok2, gtok3];
    println(str_concat("gen_text=", vocab_decode(vid, out_ids)));

    let decode_ok = (len(ids) == 2) * grow_ok
        * (gtok1 >= 0) * (gtok1 < vocab)
        * (gtok2 >= 0) * (gtok2 < vocab)
        * (gtok3 >= 0) * (gtok3 < vocab);
    let window_ok = parity0_ok * parity_ok * window_mask_only * decode_ok;
    println(str_concat("decode_ok=", to_str(decode_ok)));
    println(str_concat("window_ok=", to_str(window_ok)));
    println(str_concat("weight_session_alibi_window_ok=", to_str(window_ok)));
    println("weight_session_alibi_window_ok");

    close_weight_session(sid);
    close_vocab(vid);
}
