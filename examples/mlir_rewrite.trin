// Dialect rewrite demo (v0.25)
// emit-mlir applies pattern rewrites: "trin.*" → func.call, soft_mux folds.
// Lowered probes: dialect → 4, fold → 7, vsum → 10.

fn main() {
    let m = soft_mux(0.25, 10.0, 2.0);
    let s = sum([1.0, 2.0, 3.0, 4.0]);
    println(str_concat("soft_mux = ", to_str(m)));
    println(str_concat("sum = ", to_str(s)));
    println("dialect_probe_target = 4");
    println("fold_probe_target = 7");
    println("vsum_probe_target = 10");
}
