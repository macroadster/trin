// N-ary zip_with + filter pure eval + Go/C codegen (v0.15)

fn main() {
    // 4-way zip: w*x + y + z  with free s ignored; here (x,y,z,w)
    // [1,2] [10,20] [0.5,1.5] [2,3]
    // → 1*2+10+0.5=12.5, 2*3+20+1.5=27.5
    let a = [1.0, 2.0];
    let b = [10.0, 20.0];
    let c = [0.5, 1.5];
    let d = [2.0, 3.0];
    let ys = zip_with((x, y, z, w) => x * w + y + z, a, b, c, d);
    println(str_concat("ys = ", to_str(ys)));
    println(str_concat("sum = ", to_str(sum(ys))));

    // filter positive: filter((x)=>x, [-1,0,2,3,-4]) wait 0 dropped; use x > 0 as x itself for >0 values only via x*x? 
    // pred nonzero: keep when x itself nonzero
    let xs = [-1.0, 0.0, 2.0, 3.0, -4.0];
    let nz = filter((x) => x, xs);
    println(str_concat("nz = ", to_str(nz)));

    // keep positives: (x) => x - 0 then soft: use x for >0 values only by threshold formula
    // keep if x*x + x > 0? simpler: pred = x for nonzero; for >0 use soft_mux or (x) as-is for positives only sample:
    let pos = filter((x) => x, [1.0, -2.0, 3.0, 0.0, 4.0]);
    println(str_concat("pos = ", to_str(pos))); // nonzero: [1,-2,3,4]

    // free-var threshold: filter((x)=>x-k, xs) keeps x != k
    let k = 2.0;
    let skipped = filter((x) => x - k, [1.0, 2.0, 3.0]);
    println(str_concat("skipped = ", to_str(skipped))); // [1,3] (2-2=0 dropped)

    // compose filter + map then sum
    // map((z)=>z+1, [0,1,2])=[1,2,3]; filter((x)=>x-2,...) keeps [1,3]; sum=4
    let nested = sum(filter((x) => x - 2.0, map((z) => z + 1.0, [0.0, 1.0, 2.0])));
    println(str_concat("nested = ", to_str(nested)));
}
