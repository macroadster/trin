// v0.82 KV-cache helpers + deterministic sampling demos
fn main() {
    // empty cache → append two token rows (dim=2)
    let K = kv_new();
    let K1 = kv_append(K, [1.0, 0.0]);
    let K2 = kv_append(K1, [0.0, 1.0]);
    println(str_concat("kv_len=", to_str(kv_len(K2, 2))));
    println(str_concat("kv_row0=", to_str(kv_row(K2, 0, 2))));
    println(str_concat("kv_row1=", to_str(kv_row(K2, 1, 2))));

    // span_concat alias path
    let C = span_concat([1.0, 2.0], [3.0, 4.0]);
    println(str_concat("concat=", to_str(C)));

    // attention over growing cache
    let q = [1.0, 0.0];
    let V2 = [1.0, 2.0, 3.0, 4.0];
    let o = attn(q, K2, V2, 2);
    println(str_concat("attn_kv=", to_str(o)));

    // deterministic greedy
    let g = sample_logits([0.1, 2.5, 0.2], 0.0);
    println(str_concat("greedy=", to_str(g)));

    // deterministic seeded temperature sample (reproducible)
    let s1 = sample_logits([0.0, 0.0, 1.0, 0.0], 1.0, 42);
    let s2 = sample_logits([0.0, 0.0, 1.0, 0.0], 1.0, 42);
    println(str_concat("seed42a=", to_str(s1)));
    println(str_concat("seed42b=", to_str(s2)));

    // top-k greedy / seeded
    let tk = sample_topk([0.1, 0.9, 0.2, 0.8], 2, 0.0);
    println(str_concat("topk_greedy=", to_str(tk)));
    let tks = sample_topk([0.0, 1.0, 0.0, 0.9], 2, 1.0, 7);
    println(str_concat("topk_seed7=", to_str(tks)));

    let _ = rng_seed(99);
    let u = rng_uniform();
    println(str_concat("u=", to_str(u)));

    println("kv_sample_ok");
}
