// v0.96 — IQ2_XS + IQ2_S GGUF dequant via weight sessions
fn main() {
    let id = open_weight_session("demos/weights/W_iq2_xs.gguf");
    let w = weight_session_tensor(id, "W");
    println(str_concat("xs_n=", to_str(len(w))));
    println(str_concat("xs_w0=", to_str(w[0])));
    let y = weight_session_linear(id, "W", w, 1, 256, 8);
    println(str_concat("xs_y=", to_str(y)));
    let xs_ok = (y[0] > 200.0) * (y[0] < 300.0) * (w[0] > 0.5) * (w[0] < 1.5);
    println(str_concat("xs_match=", to_str(xs_ok)));
    close_weight_session(id);

    let id2 = open_weight_session("demos/weights/W_iq2_s.gguf");
    let w2 = weight_session_tensor(id2, "W");
    println(str_concat("s_n=", to_str(len(w2))));
    println(str_concat("s_w0=", to_str(w2[0])));
    let z = weight_session_linear(id2, "W", w2, 1, 256, 8);
    println(str_concat("s_y=", to_str(z)));
    let s_ok = (z[0] > 200.0) * (z[0] < 300.0) * (w2[0] > 0.5) * (w2[0] < 1.5);
    println(str_concat("s_match=", to_str(s_ok)));
    close_weight_session(id2);

    println(str_concat("iq2_family_ok=", to_str(xs_ok * s_ok)));
    println("weight_iq2_family_ok");
}
