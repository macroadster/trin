// v0.98 — IQ1_S + IQ1_M GGUF dequant via weight sessions
fn main() {
    let id_s = open_weight_session("demos/weights/W_iq1_s.gguf");
    let ws = weight_session_tensor(id_s, "W");
    println(str_concat("ns=", to_str(len(ws))));
    println(str_concat("ws0=", to_str(ws[0])));
    let ys = weight_session_linear(id_s, "W", ws, 1, 256, 8);
    println(str_concat("ys=", to_str(ys)));
    // each ~1.125, sum ~288, product of weights used as x → ~288
    let ok_s = (ys[0] > 250.0) * (ys[0] < 330.0) * (ws[0] > 1.0) * (ws[0] < 1.3);
    close_weight_session(id_s);

    let id_m = open_weight_session("demos/weights/W_iq1_m.gguf");
    let wm = weight_session_tensor(id_m, "W");
    println(str_concat("nm=", to_str(len(wm))));
    println(str_concat("wm0=", to_str(wm[0])));
    let ym = weight_session_linear(id_m, "W", wm, 1, 256, 8);
    println(str_concat("ym=", to_str(ym)));
    let ok_m = (ym[0] > 250.0) * (ym[0] < 330.0) * (wm[0] > 1.0) * (wm[0] < 1.3);
    close_weight_session(id_m);

    let ok = ok_s * ok_m;
    println(str_concat("iq1_family_ok=", to_str(ok)));
    println("weight_iq1_family_ok");
}
