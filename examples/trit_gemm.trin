// Trit GEMM: C = A @ B with entries in {-1,0,+1}, accumulate i32
// A is 2x3, B is 3x2, C is 2x2 (row-major flat spans)

fn main() {
    // A = [[1, 0, -1],
    //      [0, 1,  1]]
    let A = [
        trit(1), trit(0), trit(-1),
        trit(0), trit(1), trit(1)
    ];

    // B = [[1, -1],
    //      [1,  0],
    //      [0,  1]]
    let B = [
        trit(1), trit(-1),
        trit(1), trit(0),
        trit(0), trit(1)
    ];

    let C = trit_gemm(A, B, 2, 3, 2);
    // Hand:
    // C00 = 1*1 + 0*1 + (-1)*0 = 1
    // C01 = 1*(-1) + 0*0 + (-1)*1 = -2
    // C10 = 0*1 + 1*1 + 1*0 = 1
    // C11 = 0*(-1) + 1*0 + 1*1 = 1
    println(str_concat("C = ", to_str(C)));

    // Gate on first result magnitude via harden(unit_of(...)) — show ternary
    let first = C[0];
    let label =
        (first > 0)
            | "C00 positive"
            | "C00 non-positive";
    println(label);
}
