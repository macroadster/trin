// v0.90 — multi-layer residual fused linear + RMSNorm on one weight session
fn main() {
    let id = open_weight_session("demos/weights/layer_stack.gguf");
    let x = [1.0, 2.0, 3.0];
    // one block
    let b0 = weight_session_forward_block(id, "W0", x, 3, "g0", "residual", 1, 0.000001);
    println(str_concat("b0=", to_str(b0)));
    // two-layer stack
    let y = weight_session_layer_stack(id, "W0,W1", x, 3, "g0,g1", "residual,residual", 1, 0.000001);
    println(str_concat("y=", to_str(y)));
    // compose manually via blocks for parity
    let m1 = weight_session_forward_block(id, "W0", x, 3, "g0", "residual", 1, 0.000001);
    let m2 = weight_session_forward_block(id, "W1", m1, 3, "g1", "residual", 1, 0.000001);
    println(str_concat("m2=", to_str(m2)));
    println(str_concat("stack_match=", to_str((y[0] == m2[0]) * (y[1] == m2[1]) * (y[2] == m2[2]))));
    // plain mode drops residual
    let p = weight_session_forward_block(id, "W0", x, 3, "g0", "plain", 1, 0.000001);
    println(str_concat("plain=", to_str(p)));
    close_weight_session(id);
    println("weight_session_layer_stack_ok");
}
