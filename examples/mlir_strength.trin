// soft_mux strength / algebraic folds demo (v0.29)
// identity pure==each → 5
// each=0 → w*pure = 0.5*6 = 3
// pure=0 → (1-w)*each = 0.5*3 = 1.5
// full const soft_mux(0.25,10,2) = 4
// sum = 13.5

fn main() {
    let w = 0.5;
    let id = soft_mux(w, 5.0, 5.0);
    let mp = soft_mux(w, 6.0, 0.0);
    let me = soft_mux(w, 0.0, 3.0);
    let fc = soft_mux(0.25, 10.0, 2.0);
    let s = id + mp + me + fc;
    println(str_concat("ident = ", to_str(id)));
    println(str_concat("mul_pure = ", to_str(mp)));
    println(str_concat("mul_each = ", to_str(me)));
    println(str_concat("full_const = ", to_str(fc)));
    println(str_concat("strength_sum = ", to_str(s)));
    println("strength_probe_target = 13.5");
}
